# Postgres connection string: the local Docker Desktop container
# (`npm run db:up` from the repo root).
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5442/payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of this CMS
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Astro site (allowed by CORS/CSRF and loaded in the Live Preview iframe)
WEB_URL=http://localhost:4321

# Shared with apps/web; lets Astro know a request comes from Live Preview
PREVIEW_SECRET=change-me

# API key the seed assigns to the "preview" user; Astro uses it to read drafts.
# Generate one with: node -e "console.log(crypto.randomUUID())"
PREVIEW_API_KEY=
